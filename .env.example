# ---------------------------------------------------------------------------
# ArchitectOS — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need. `.env` and
# `.env.local` are gitignored, so your keys never end up in the repository.
#
#   macOS / Linux:
#     cp .env.example .env
#   Windows (PowerShell):
#     Copy-Item .env.example .env
#
# Loading order (backend/architectos/service.py):
#   `.env.local`  →  `.env`  →  process environment (never overwritten)
# The UI also writes keys to `.env.local` when you save a provider under
# Setup → Providers. Secrets are NEVER stored in the SQLite database.
# See docs/CONFIGURATION.md for details.
# ---------------------------------------------------------------------------

# --- Core model providers (Ask / Chat / AI Router) --------------------------
# At least one API provider is required for AI answers. The Smart Router
# auto-selects among the providers you enable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Google Gemini / Antigravity CLI
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Azure OpenAI (set all three)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=          # e.g. https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=        # deployment name used as the model id

# Ollama (local, no key) — http://127.0.0.1:11434 is the default
OLLAMA_HOST=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Memory embeddings (optional) -------------------------------------------
# Default is a dependency-free local hash embedder — nothing to configure.
# For real vectors install the extras and pick ONE provider:
#   pip install -e ".[vectors,embeddings]"
# Providers: hash | local (fastembed) | ollama | openai | azure-openai | gemini | cloudflare
# MEMORY_EMBEDDING_PROVIDER=
# OPENAI_API_KEY=                # reused for the openai embedder
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# GEMINI_API_KEY=                # reused for the gemini embedder
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# OLLAMA_EMBED_MODEL=

# --- MCP integration servers (optional) -------------------------------------
GITHUB_PERSONAL_ACCESS_TOKEN=
GITLAB_PERSONAL_ACCESS_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4

# Azure DevOps MCP server (ADO_ORG + ADO_MCP_AUTH_TOKEN)
ADO_ORG=
ADO_MCP_AUTH_TOKEN=
# Azure Boards / Git / Wiki sync (alternative org + PAT)
AZURE_DEVOPS_ORG=
PERSONAL_ACCESS_TOKEN=

# --- Microsoft Graph / Teams (optional) -------------------------------------
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_USER_ID=
TEAMS_USER_ID=
# Alternative: a static Graph token instead of a client secret flow
# MS_GRAPH_ACCESS_TOKEN=
TEAMS_LOOKBACK_DAYS=14

# --- Runtime / server (optional overrides) ----------------------------------
# ARCHITECTOS_ROOT=            # data root (default: the checkout directory)
# ARCHITECTOS_HOST=127.0.0.1
# ARCHITECTOS_PORT=8766
# ARCHITECTOS_ENV=local
# ARCHITECTOS_BACKUP_RETENTION=10
