{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArchitectOS",
  "version": "1.0.0",
  "identifier": "app.architectos.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:8766",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ArchitectOS",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/architectos-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI workspace for software engineers",
    "longDescription": "ArchitectOS desktop shell: Tauri webview around the local Python memory server and SPA.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
